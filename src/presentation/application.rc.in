#include <windows.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/src/presentation/windows_resources.h"
VE_ICON_RESOURCE_ID ICON "@VE_ICON_PATH@"
STRINGTABLE
BEGIN
 VE_DISPLAY_NAME_RESOURCE_ID "@VE_PRODUCT_NAME@"
END
1 VERSIONINFO
 FILEVERSION @VE_VERSION_NUMERIC@
 PRODUCTVERSION @VE_VERSION_NUMERIC@
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Merserk\0"
   VALUE "FileDescription", "@VE_FILE_DESCRIPTION@\0"
   VALUE "ProductName", "@VE_PRODUCT_NAME@\0"
   VALUE "FileVersion", "@VE_VERSION_STRING@\0"
   VALUE "ProductVersion", "@VE_VERSION_STRING@\0"
   VALUE "LegalCopyright", "Copyright (C) 2026 Merserk\0"
   VALUE "OriginalFilename", "@VE_ORIGINAL_FILENAME@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
