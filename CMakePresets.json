{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 / MSVC / Qt 6.12.x",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{VE_QT_ROOT}",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "jobs": 8
    },
    {
      "name": "debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "jobs": 8
    }
  ]
}
